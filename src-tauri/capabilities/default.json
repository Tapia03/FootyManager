{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "postgrest", "sidecar": true, "args": true },
        { "name": "node", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-kill"
  ]
}
